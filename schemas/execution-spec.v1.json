{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildos.invalid/schemas/execution-spec.v1.json",
  "title": "Build OS pre-execution envelope source",
  "type": "object",
  "required": ["schema", "plan_id", "cost_class", "assumptions", "capabilities", "authorities", "commands", "claims", "effects", "steps", "recovery"],
  "properties": {
    "schema": {"const": "buildos.execution-spec.v1"},
    "plan_id": {"$ref": "#/$defs/id"},
    "cost_class": {"enum": ["LOW", "MEDIUM", "HIGH", "EXTERNAL"]},
    "assumptions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assumption"}},
    "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capability"}},
    "authorities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/authority"}},
    "commands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/command"}},
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
    "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "recovery": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/recovery"}}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
    "idList": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "assumption": {
      "type": "object",
      "required": ["id", "statement", "status", "critical", "evidence", "fallback"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "statement": {"type": "string", "minLength": 1},
        "status": {"enum": ["PROVEN", "BOUNDED", "UNKNOWN", "REJECTED"]}, "critical": {"type": "boolean"},
        "evidence": {"type": ["string", "null"]}, "fallback": {"type": ["string", "null"]}
      }, "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["id", "status", "source", "evidence", "constraints"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["AVAILABLE", "UNAVAILABLE", "UNKNOWN", "DISCOVERABLE", "RESTRICTED"]},
        "source": {"enum": ["OWNER", "DETERMINISTIC_PROBE", "PROVIDER_CONTRACT", "PACKAGE"]},
        "evidence": {"type": ["string", "null"]}, "constraints": {"type": "object"}
      }, "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["field", "owner", "owner_kind", "mode", "evidence"],
      "properties": {
        "field": {"$ref": "#/$defs/id"}, "owner": {"type": "string", "minLength": 1},
        "owner_kind": {"enum": ["PRODUCT", "LIFECYCLE", "DETERMINISTIC_COMPILER", "PROVIDER", "QC", "HUMAN", "LLM"]},
        "mode": {"enum": ["CANONICAL", "ADVISORY", "DERIVED", "EXECUTOR"]}, "evidence": {"type": ["string", "null"]}
      }, "additionalProperties": false
    },
    "command": {
      "type": "object", "required": ["id", "argv", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "provenance": {"enum": ["OWNER_AUTHORED", "PACKAGE_OWNED", "MODEL_PROPOSED_APPROVED"]}
      }, "additionalProperties": false
    },
    "claim": {
      "type": "object", "required": ["id", "description", "command_id", "dependencies", "mode", "role", "acceptance"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "description": {"type": "string", "minLength": 1}, "command_id": {"$ref": "#/$defs/id"},
        "dependencies": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "mode": {"enum": ["AFFECTED", "FINAL"]}, "role": {"enum": ["ACCEPTANCE", "ROLLBACK_RECOVERY", "SECURITY", "QC"]},
        "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }, "additionalProperties": false
    },
    "effect": {
      "type": "object", "required": ["id", "idempotency", "idempotency_key", "no_effect_predicate", "provider_capability", "deadline_seconds", "required"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "idempotency": {"enum": ["IDEMPOTENT_WITH_KEY", "NON_IDEMPOTENT"]},
        "idempotency_key": {"type": ["string", "null"]}, "no_effect_predicate": {"type": ["string", "null"]},
        "provider_capability": {"$ref": "#/$defs/id"}, "deadline_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "required": {"type": "boolean"}
      }, "additionalProperties": false
    },
    "step": {
      "type": "object", "required": ["id", "kind", "after", "requires_assumptions", "requires_capabilities", "capability_constraints", "reads", "writes", "effect_id", "failure_families"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["LOCAL", "EXTERNAL_EFFECT", "REVIEW", "PERSIST"]},
        "after": {"$ref": "#/$defs/idList"}, "requires_assumptions": {"$ref": "#/$defs/idList"},
        "requires_capabilities": {"$ref": "#/$defs/idList"}, "capability_constraints": {"type": "object"},
        "reads": {"$ref": "#/$defs/idList"}, "writes": {"$ref": "#/$defs/idList"},
        "effect_id": {"type": ["string", "null"]}, "failure_families": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
      }, "additionalProperties": false
    },
    "recovery": {
      "type": "object", "required": ["family", "disposition", "max_bounded_occurrences", "evidence_required"],
      "properties": {
        "family": {"$ref": "#/$defs/id"}, "disposition": {"enum": ["BOUNDED_FIX", "REPLAN", "RECONCILE", "STOP"]},
        "max_bounded_occurrences": {"type": "integer", "minimum": 0, "maximum": 1}, "evidence_required": {"type": "boolean"}
      }, "additionalProperties": false
    }
  }
}
