{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cads.local/schemas/external-skills-lock.schema.json",
  "title": "CADS External Skills Provenance Lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skills"],
  "properties": {
    "schema_version": {"const": 1},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "source_revision",
          "source_path",
          "bundle_sha256",
          "license",
          "content_class",
          "selected_for",
          "reviewed_at",
          "review_method"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "source": {"type": "string", "minLength": 1},
          "source_revision": {"type": "string", "minLength": 1},
          "source_path": {"type": "string", "minLength": 1},
          "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "license": {"type": "string", "minLength": 1},
          "content_class": {"const": "docs-only"},
          "selected_for": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string", "minLength": 1},
          "review_method": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
