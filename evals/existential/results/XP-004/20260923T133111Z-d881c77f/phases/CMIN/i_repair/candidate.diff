new file mode 100644
index 0000000..eaf9121
--- /dev/null
+++ b/videopipeline/acceptance.py
@@ -0,0 +1,154 @@
+"""Recheck byte-bound evidence emitted by a completed local render."""
+import hashlib
+import json
+import subprocess
+from pathlib import Path
+from typing import Any, Dict, List
+
+
+def _frame_rgb(path: Path, seconds: float) -> bytes:
+    result = subprocess.run(
+        ["ffmpeg", "-v", "error", "-ss", f"{max(0, seconds):.3f}", "-i", str(path),
+         "-frames:v", "1", "-vf", "scale=32:18:force_original_aspect_ratio=decrease,pad=32:18:(ow-iw)/2:(oh-ih)/2",
+         "-f", "rawvideo", "-pix_fmt", "rgb24", "-"],
+        capture_output=True, check=False,
+    )
+    if result.returncode or len(result.stdout) != 32 * 18 * 3:
+        raise ValueError(f"Could not decode verification frame from {path}")
+    return result.stdout
+
+
+def _region_mean(frame: bytes, region: str) -> List[float]:
+    # Coarse color signatures are robust to codec noise and catch wrong-source renders.
+    coords = {
+        "all": (0, 0, 32, 18), "center": (8, 4, 24, 14),
+        "corner": (0, 0, 6, 6),
+    }[region]
+    x0, y0, x1, y1 = coords
+    pixels = [frame[(y * 32 + x) * 3:(y * 32 + x) * 3 + 3]
+              for y in range(y0, y1) for x in range(x0, x1)]
+    return [sum(pixel[channel] for pixel in pixels) / len(pixels) for channel in range(3)]
+
+
+def _matches_source(source: Path, output: Path, source_time: float, output_time: float,
+                    source_region: str = "all", output_region: str = "all") -> Dict[str, Any]:
+    expected = _region_mean(_frame_rgb(source, source_time), source_region)
+    observed = _region_mean(_frame_rgb(output, output_time), output_region)
+    error = sum(abs(a - b) for a, b in zip(expected, observed)) / 3
+    return {"source": str(source), "source_rgb_mean": expected, "output_rgb_mean": observed,
+            "mean_absolute_error": error, "passed": error <= 45}
+
+
+def verify_visual_evidence(data: Dict[str, Any]) -> List[str]:
+    """Decode output frames and check their visual signatures against each declared source."""
+    output = Path(data.get("output_file", ""))
+    schedule = data.get("product_state", {}).get("timeline_state", {})
+    segments = schedule.get("segments", [])
+    fmt = data.get("format_id")
+    failures: List[str] = []
+    if not output.is_file() or not segments:
+        return ["visual evidence lacks output or timeline segments"]
+    checks = []
+    offset = 0.0
+    for segment in segments:
+        duration = float(segment.get("duration", 0))
+        source = Path(segment.get("source_path") or segment.get("source", ""))
+        source_class = segment.get("source_class", "")
+        segment_type = segment.get("segment_type") or segment.get("type", "")
+        sample_out = (max(0.05, duration * 0.5) if fmt == "F4"
+                      else offset + max(0.05, duration * 0.5))
+        source_time = (0.0 if source.suffix.lower() in {".jpg", ".jpeg", ".png", ".webp", ".bmp"}
+                       else float(segment.get("start_time", segment.get("start", 0))) + max(0.05, duration * 0.5))
+        if fmt == "F4" and segment_type == "f1_framed":
+            # F4's original is the inset, while the separately declared stock asset is its canvas.
+            checks.append(_matches_source(source, output, source_time, sample_out, "center", "center"))
+            bg = next((Path(s.get("source_path") or s.get("source")) for s in segments
+                       if s.get("source_class") == "STOCK_ONLINE" and (s.get("source_path") or s.get("source"))), None)
+            if bg is None:
+                failures.append("F4 background source missing from evidence")
+            else:
+                checks.append(_matches_source(bg, output, duration * 0.5, sample_out, "all", "corner"))
+        elif fmt == "F4":
+            # Background is composited beneath the inset; it is not a concat segment.
+            offset += duration
+            continue
+        else:
+            checks.append(_matches_source(source, output, source_time, sample_out))
+        offset += duration
+    for index, check in enumerate(checks):
+        if not check["passed"]:
+            failures.append(f"decoded source comparison {index} failed (MAE {check['mean_absolute_error']:.1f})")
+    data.setdefault("product_state", {})["visual_evidence"] = checks
+    return failures
+
+
+def _file_hash(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def verify_run_manifest(manifest_path: Path) -> Dict[str, Any]:
+    """Return valid only while all bound assets, state files, code, and output match."""
+    manifest_path = Path(manifest_path)
+    data = json.loads(manifest_path.read_text(encoding="utf-8"))
+    failures: List[str] = []
+    if data.get("accepted") is not True:
+        failures.append("run is not marked accepted")
+
+    def check(path_text: str, expected: str, label: str) -> None:
+        path = Path(path_text) if path_text else None
+        if not path or not path.is_file():
+            failures.append(f"{label} missing: {path_text}")
+        elif not expected or _file_hash(path) != expected:
+            failures.append(f"{label} hash mismatch: {path_text}")
+
+    check(data.get("output_file", ""), data.get("output_sha256", ""), "output")
+    if data.get("format_id") not in {"F1", "F2", "F3", "F4", "F5"}:
+        failures.append("unsupported or missing selected format")
+    for asset in data.get("assets_used", []):
+        check(asset.get("source_path", ""), asset.get("sha256", ""), f"asset {asset.get('index')}")
+    state = data.get("product_state", {})
+    try:
+        from .format_validator import FormatValidator
+        from .models import FormatId, create_default_format_plan
+        selected = FormatId(data.get("format_id", ""))
+        timeline = state.get("timeline_state", {})
+        if timeline.get("format_id") != selected.value:
+            failures.append("selected format does not match timeline format")
+        segments = timeline.get("segments", [])
+        from .models import VisualSegment, SourceClass
+        rebuilt = [VisualSegment(
+            index=s["index"], start_time=s.get("start_time", s.get("start", 0)), duration=s["duration"],
+            segment_type=s.get("segment_type", s.get("type", "")), source_path=Path(s.get("source_path") or s.get("source", "")),
+            source_class=SourceClass(s["source_class"]) if s.get("source_class") else None,
+            asset_id=s.get("asset_id", ""), description=s.get("description", ""))
+            for s in segments]
+        FormatValidator.validate_timeline(rebuilt, create_default_format_plan(selected), require_files=True)
+    except Exception as exc:
+        failures.append(f"format/source validation failed: {exc}")
+    canonical_timeline = json.dumps(state.get("timeline_state"), sort_keys=True, ensure_ascii=False, default=str).encode("utf-8")
+    if hashlib.sha256(canonical_timeline).hexdigest() != state.get("timeline_sha256"):
+        failures.append("timeline state hash mismatch")
+    check(state.get("compose_path", ""), state.get("compose_sha256", ""), "compose state")
+    check(state.get("audio_path", ""), state.get("audio_sha256", ""), "audio")
+    if state.get("timeline_file_sha256"):
+        check(state.get("timeline_path", ""), state["timeline_file_sha256"], "timeline state")
+    if not state.get("visual_evidence"):
+        failures.append("decoded visual evidence missing")
+    else:
+        try:
+            failures.extend(verify_visual_evidence(data))
+        except Exception as exc:
+            failures.append(f"decoded visual verification failed: {exc}")
+    package = Path(__file__).resolve().parent
+    digest = hashlib.sha256()
+    for source in sorted(package.rglob("*.py")):
+        digest.update(source.relative_to(package).as_posix().encode("utf-8"))
+        digest.update(_file_hash(source).encode("ascii"))
+    if digest.hexdigest() != state.get("candidate_sha256"):
+        failures.append("candidate code hash mismatch")
+    return {"valid": not failures, "failures": failures, "format_id": data.get("format_id"),
+            "output_file": data.get("output_file"), "output_sha256": data.get("output_sha256")}
